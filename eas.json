{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "config": "preview-android.yml"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "config": "preview-android.yml"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "config": "production-android.yml"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
